# This .gitignore file should be placed at the root of your Unity project directory
#
# Unity generated folders
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/

# Unity Version Control / Plastic SCM
.plastic/
ignore.conf

# Gradle cache directory
.gradle/

# Autogenerated VS / Rider / MonoDevelop / Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.csproj.lscache
*.unityproj
*.sln
*.slnx
*.slnx.DotSettings
*.sln.DotSettings
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for debug files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Logs
*.log
sysinfo.txt
*.stackdump

# Builds / packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Wrong Windows-created text versions
.gitignore.txt
.gitattributes.txt
README.md.txt

# OS files
.DS_Store
Thumbs.db